</sql><sql name="SQL 3">CREATE INDEX idx_product_cat_price ON product (category_id, price);
</sql><sql name="SQL 4">EXPLAIN QUERY PLAN SELECT * FROM product WHERE price &gt; 100;
</sql><sql name="SQL 5">DROP INDEX idx_product_price;
</sql><sql name="SQL 6">CREATE UNIQUE INDEX idx_product_title_unique ON product(title);
</sql><sql name="SQL 7">SELECT title, COUNT(*) 
